# Required for the ECC integration harness
GITHUB_TOKEN=
LINEAR_API_KEY=
LINEAR_PROJECT_ID=
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=
SLACK_CHANNEL_IDS=
SLACK_DEFAULT_CHANNEL_ID=
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
LINEAR_TEAM_ID=
GITHUB_REPOSITORY=
ECC_AUTO_SYNC_LINEAR=true
ECC_COMPACT_PROMPTS=true
ECC_AUTO_LOOP_CYCLES=20
ECC_AUTO_LOOP_INTERVAL=30
ECC_LOCALE=en

# Optional model/API keys used by downstream agent workflows
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional local agent command overrides.
# Agent ids and default commands live in ecc_agents.json.
# Gemini is optional and disabled until ECC_GEMINI_COMMAND is set.
ECC_PLANNER_COMMAND=
ECC_CODEX_COMMAND=
ECC_GEMINI_COMMAND=
ECC_CLAUDE_CODE_COMMAND=
